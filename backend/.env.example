# Thiết lập trong môi trường trước khi chạy python backend/app.py.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=iot_db
DB_USER=root
DB_PASSWORD=replace-with-your-local-password
PORT=5000
MQTT_ENABLED=1
MQTT_BROKER=broker.emqx.io
MQTT_PORT=1883
MQTT_TOPIC=iot/heatindex/tien01/data
DEVICE_ONLINE_SECONDS=120
CORS_ORIGINS=*

# Admin: create locally with python tool/manage_admin.py --generate.
# Alternatively supply all three values in the server environment.
# ADMIN_USER=admin
# ADMIN_PASSWORD_HASH=<Werkzeug password hash>
# SECRET_KEY=<random persistent session signing key>
# Set to 1 when serving through HTTPS.
SESSION_COOKIE_SECURE=0

# Public rain-aware route planning (read-only APIs; no admin session required).
VALHALLA_URL=https://valhalla1.openstreetmap.de
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
GEOCODER_URL=https://nominatim.openstreetmap.org/search
ROUTING_USER_AGENT=HeatWatch/1.0 (IoT weather route planner)
